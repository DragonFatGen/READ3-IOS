[
  {"name":"empty","rule":""},
  {"name":"selector","rule":"div.book@text"},
  {"name":"css","rule":"@CSS:div.book > a@href"},
  {"name":"jsonpath","rule":"$.items[*].name"},
  {"name":"xpath","rule":"//div[@class='book']"},
  {"name":"javascript-prefix","rule":"@js:result && 'literal'"},
  {"name":"javascript-tag","rule":"div<js>result || []</js>@text"},
  {"name":"replacement","rule":"div@text##\\s+## ##"},
  {"name":"template","rule":"prefix-{{result.name}}-suffix"},
  {"name":"concatenate","rule":"a&&b"},
  {"name":"fallback","rule":"a||b"},
  {"name":"interleave","rule":"a%%b"},
  {"name":"three","rule":"a&&b&&c"},
  {"name":"precedence","rule":"a&&b||c"},
  {"name":"json-filter-operators","rule":"$[?(@.a && @.b || @.c)]"},
  {"name":"regex-operator","rule":"div##a&&b##x"},
  {"name":"template-operator","rule":"a{{left&&right}}b"},
  {"name":"escaped-operator","rule":"a\\&&b"},
  {"name":"empty-branch","rule":"a&&"},
  {"name":"unterminated-template","rule":"a{{result"},
  {"name":"explicit-json","rule":"@Json:$['value']"},
  {"name":"explicit-xpath","rule":"@XPath://a/@href"},
  {"name":"legacy-force-default","rule":"@@div@text"},
  {"name":"all-in-one-regex","rule":":<li>(.*?)</li>&&href=([^ ]+)"}
]
